    <div class="info">
      <p><strong>Nom de l'étudiant :</strong> Yahya AHMANE</p>
      <p><strong>Numéro d'étudiant (CNE) :</strong> R139310095</p>
      <p><strong>Nom de l'instance :</strong> {{ inventory_hostname }}</p>
      <p><strong>Adresse IP flottante :</strong> {{ ansible_host }}</p>
      <p><strong>Statut du service :</strong> <span class="status">● Nginx démarré et activé au démarrage</span></p>
